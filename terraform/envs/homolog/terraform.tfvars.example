# Copie este arquivo para terraform.tfvars e preencha com os valores reais
# NUNCA commite o terraform.tfvars — ele já está no .gitignore

# Subnets privadas publicadas por P4
vpc_subnet_ids = ["subnet-xxxxxxxxxxxxxxxxx", "subnet-yyyyyyyyyyyyyyyyy"]

# Security groups publicados por P4
vpc_security_group_ids = ["sg-xxxxxxxxxxxxxxxxx"]
